import Mathlib.Data.Real.Basic
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Positivity

/-!
# Kritzinger's greedy sequence: definitions

Points live in `[0,1]` and are given as a list. All discrepancies here are
*unnormalised* (counts, not proportions).

Reference: R. Kritzinger, "Uniformly distributed sequences generated by a
greedy minimization of the L2 discrepancy", arXiv:2109.06298 (Algorithm 2).
-/

namespace GreedyDiscrepancy

/-- Squared unnormalised L² star discrepancy of a finite point list, in the
closed form of Warnock's formula:
`∫₀¹ (#{k : y_k ≤ t} − M t)² dt = Σ_{k,l} (1 − max y_k y_l) − M Σ_k (1 − y_k²) + M²/3`.
The identity with the integral is not formalised here. -/
noncomputable def l2sq (ys : List ℝ) : ℝ :=
  (ys.map fun a => (ys.map fun b => 1 - max a b).sum).sum
    - (ys.length : ℝ) * (ys.map fun a => 1 - a ^ 2).sum + (ys.length : ℝ) ^ 2 / 3

/-- Kritzinger's objective `f_N(x) = −2 Σ max(x_k, x) + (N+1) x² − x`. -/
noncomputable def kObj (xs : List ℝ) (x : ℝ) : ℝ :=
  -2 * (xs.map fun a => max a x).sum + ((xs.length : ℝ) + 1) * x ^ 2 - x

/-- `x` minimises Kritzinger's objective over `[0,1]` after the points `xs`. -/
def IsGreedyStep (xs : List ℝ) (x : ℝ) : Prop :=
  0 ≤ x ∧ x ≤ 1 ∧ ∀ y : ℝ, 0 ≤ y → y ≤ 1 → kObj xs x ≤ kObj xs y

/-- `x` is the least minimiser (Kritzinger's tie-break rule). -/
def IsLeastGreedyStep (xs : List ℝ) (x : ℝ) : Prop :=
  IsGreedyStep xs x ∧ ∀ y : ℝ, IsGreedyStep xs y → x ≤ y

/-- The first `n` terms `x 0, …, x (n-1)` of a sequence. -/
def pref (x : ℕ → ℝ) (n : ℕ) : List ℝ := (List.range n).map x

/-- The Kritzinger sequence: start at `1/2`, then take the least minimiser. -/
def IsKritzingerSeq (x : ℕ → ℝ) : Prop :=
  x 0 = 1 / 2 ∧ ∀ n : ℕ, IsLeastGreedyStep (pref x (n + 1)) (x (n + 1))

/-- Number of points of `xs` in `[0, t)`. -/
noncomputable def countBelow (xs : List ℝ) (t : ℝ) : ℕ := xs.countP fun a => decide (a < t)

/-- The unnormalised star discrepancy of `xs` is at most `C`. -/
def StarDiscLE (xs : List ℝ) (C : ℝ) : Prop :=
  ∀ t : ℝ, 0 ≤ t → t ≤ 1 → |(countBelow xs t : ℝ) - xs.length * t| ≤ C

/-- Kritzinger's conjecture (arXiv:2109.06298; Conjecture 2.2 in
arXiv:2406.18132): the star discrepancy of the first `n` points is `O(log n)`.
Stated, not proved. -/
def KritzingerConjecture : Prop :=
  ∀ x : ℕ → ℝ, IsKritzingerSeq x →
    ∃ C : ℝ, ∀ n : ℕ, 2 ≤ n → StarDiscLE (pref x n) (C * Real.log n)

end GreedyDiscrepancy
